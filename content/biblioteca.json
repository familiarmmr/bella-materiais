  "intro": {
    "title": "Biblioteca de materiais",
    "subtitle": "Curadoria prática para a Família. Sessões curtas, lúdicas e sem pressão.",
    "nivel": "Criança reconhece e escreve algumas letras e números — reforçar o conhecido e avançar no máximo 1 novidade por vez.",
    "comoUsar": [
      {
        "label": "Duração",
        "text": "10–15 minutos por sessão (pode ser 5 se estiver cansada)"
      },
      {
        "label": "Frequência",
        "text": "4–5 dias por semana; ok pular dia"
      },
      {
        "label": "Tom",
        "text": "Convite, não cobrança: “Vamos brincar de…?”"
      },
      {
        "label": "Fim",
        "text": "Pare no auge do interesse"
      },
      {
        "label": "Papel do adulto",
        "text": "Sentar junto, nomear o que ela faz, celebrar tentativa"
      },
      {
        "label": "Progressão",
        "text": "Começar pelo que ela já sabe; só avança 1 passinho quando estiver fácil"
      }
    ]
  },
